{
  "target": "/app/packages/server/dist/server.js",
  "env": {
    "base_url": "BASE_URL",
    "secret_key": "SECRET_KEY",
    "aiostreams_auth": "AIOSTREAMS_AUTH",
    "aiostreams_auth_permissions": "AIOSTREAMS_AUTH_PERMISSIONS",
    "database_uri": "DATABASE_URI",
    "database_pool_size": "DATABASE_POOL_SIZE",
    "redis_uri": "REDIS_URI",
    "redis_timeout": "REDIS_TIMEOUT",
    "settings_refresh_interval": "SETTINGS_REFRESH_INTERVAL",
    "internal_url": "INTERNAL_URL",
    "disk_cache_dir": "DISK_CACHE_DIR",
    "log_buffer_max_bytes": "LOG_BUFFER_MAX_BYTES",
    "log_buffer_max_entries": "LOG_BUFFER_MAX_ENTRIES",
    "node_env": "NODE_ENV",
    "system_lifecycle_enabled": "SYSTEM_LIFECYCLE_ENABLED",
    "log_level": "LOG_LEVEL",
    "log_format": "LOG_FORMAT",
    "auth_required": "AIOSTREAMS_AUTH_REQUIRED",
    "allow_private_urls": "ALLOW_PRIVATE_URLS",
    "default_timeout": "DEFAULT_TIMEOUT",
    "addon_password": "ADDON_PASSWORD",
    "config_access_key": "CONFIG_ACCESS_KEY",
    "session_ttl_seconds": "SESSION_TTL_SECONDS",
    "enable_search_api": "ENABLE_SEARCH_API",
    "enable_nab_api": "ENABLE_NAB_API",
    "addon_name": "ADDON_NAME",
    "addon_id": "ADDON_ID",
    "custom_html": "CUSTOM_HTML",
    "tmdb_api_key": "TMDB_API_KEY",
    "tmdb_access_token": "TMDB_ACCESS_TOKEN",
    "tvdb_api_key": "TVDB_API_KEY",
    "trakt_client_id": "TRAKT_CLIENT_ID",
    "log_sensitive_info": "LOG_SENSITIVE_INFO",
    "aio_oidc_enabled": "AIOSTREAMS_OIDC_ENABLED",
    "aio_oidc_issuer": "AIOSTREAMS_OIDC_ISSUER",
    "aio_oidc_client_id": "AIOSTREAMS_OIDC_CLIENT_ID",
    "aio_oidc_client_secret": "AIOSTREAMS_OIDC_CLIENT_SECRET"
  },
  "required": [
    "secret_key"
  ],
  "mode": "node",
  "data_path": "/app/data"
}
